# ==============================================================================
# VOLLEYBALL LIVE AUCTION MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Connection pooling URL (Port 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL for migrations and DDL (Port 5432)
DIRECT_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Authentication & Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Player & Team Logo Image Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="volleyball_auction"

# ------------------------------------------------------------------------------
# 4. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

